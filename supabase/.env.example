# Copy to .env and fill in. Only the function reads these.
# Never put real values in assets/ or commit this file.

# Every origin allowed to call the function, comma separated. The dev server
# serves 127.0.0.1 by default, and browsers treat localhost and 127.0.0.1 as
# separate origins, so list both while you work locally.

ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://YOUR-USERNAME.github.io
MAX_IMAGE_SIZE=26214400
MAX_GIF_SIZE=26214400
MAX_VIDEO_SIZE=52428800
MAX_POSTER_SIZE=2097152
MAX_TOTAL_BYTES=858993459
ALBUMS_PER_HOUR=5
ITEMS_PER_ALBUM=200
REPORTS_PER_HOUR=10
