# Copy this file to .env and fill it in. .env is gitignored, so these values
# never reach a commit. They are written into dist/ at build time only.

# The browser needs exactly these two from Settings > API.
# ARCHIVE_API_KEY is the publishable or anon key, never the service role key.
ARCHIVE_API_URL=https://YOUR-PROJECT-REF.supabase.co
ARCHIVE_API_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Optional. These two only change branding.
ARCHIVE_SITE_NAME=Community Archive
ARCHIVE_NAME=BNG
